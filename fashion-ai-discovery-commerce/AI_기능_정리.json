  "api_endpoints": [
    {
      "id": 7,
      "name": "Chat API",
      "location": "backend/app/api/api_v1/endpoints/chat.py",
      "endpoints": [
        {
          "method": "POST",
          "path": "/api/v1/chat/message",
          "description": "사용자 메시지 처리",
          "request": {
            "message": "미니멀 셔츠 추천해줘",
            "user_id": "user123",
            "session_id": "session456"
          },
          "response": {
            "response": "미니멀 스타일의 셔츠를 추천해드릴게요! ...",
            "session_id": "session456",
            "recommendations": [
              {
                "id": "prod001",
                "name": "미니멀 코튼 셔츠",
                "brand": "브랜드A",
                "price": 59000,
                "similarity_score": 0.92,
                "recommendation_type": "exploitation"
              }
            ],
            "intent": "감성·스타일",
            "confidence": 0.95
          }
        },
        {
          "method": "GET",
          "path": "/api/v1/chat/history/{session_id}",
          "description": "대화 히스토리 조회"
        },
        {
          "method": "GET",
          "path": "/api/v1/chat/sessions/{user_id}",
          "description": "사용자 세션 목록 조회"
        },
        {
          "method": "WebSocket",
          "path": "/api/v1/chat/ws/{user_id}",
          "description": "실시간 채팅 지원"
        }
      ]
    }
  ],
  "execution_flow": {
    "description": "전체 프로세스 흐름",
    "steps": [
      {
        "step": 1,
        "action": "사용자 메시지 입력",
        "example": "미니멀 셔츠 추천해줘"
      },
      {
        "step": 2,
        "action": "ChatService.process_message()"
      },
      {
        "step": 3,
        "action": "IntentClassifier.classify_intent()",
        "output": {
          "intent": "감성·스타일",
          "exploration_intent": false,
          "recommendation_strategy": {
            "exploitation": 0.7,
            "exploration": 0.3
          }
        }
      },
      {
        "step": 4,
        "action": "SearchEngine.search_products()",
        "process": [
          "임베딩 생성",
          "벡터 검색",
          "50개 후보 선정"
        ]
      },
      {
        "step": 5,
        "action": "MMRScorer.select_recommendations()",
        "process": [
          "MMR 알고리즘",
          "10개 선택 (다양성 보장)"
        ]
      },
      {
        "step": 6,
        "action": "스타일 다양성 강제 검증",
        "process": [
          "3개 이상 다른 스타일 확인",
          "부족 시 추가 선택"
        ]
      },
      {
        "step": 7,
        "action": "ResponseGenerator.generate_response()",
        "process": [
          "프롬프트 생성",
          "GPT API 호출",
          "후처리"
        ]
      },
      {
        "step": 8,
        "action": "최종 응답 반환",
        "output": {
          "response": "미니멀 스타일의 셔츠를 추천해드릴게요! ...",
          "recommendations": [],
          "intent": "감성·스타일"
        }
      }
    ]
  },
