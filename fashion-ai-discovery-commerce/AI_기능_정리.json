{
  "project_name": "패션 AI 추천 시스템",
  "version": "1.0.0",
  "last_updated": "2025-01-02",
  "overview": {
    "architecture": {
      "flow": [
        "사용자 메시지 입력",
        "Intent Analyzer - 의도 분석 (5가지 Intent 분류)",
        "Vector Search - 벡터 기반 상품 검색",
        "MMR Algorithm - 다양성 있는 추천 선택",
        "Response Generator - 자연어 응답 생성",
        "최종 추천 결과 + AI 응답"
      ]
    },
    "tech_stack": {
      "llm": "GPT-4o-mini (OpenAI)",
      "embedding": "text-embedding-3-large (OpenAI)",
      "vector_store": "SQL 기반 (PostgreSQL/SQLite)",
      "algorithm": "MMR (Maximal Marginal Relevance)"
    }
  },
  "core_ai_modules": [
    {
      "id": 1,
      "name": "Intent Analyzer",
      "name_kr": "의도 분석",
      "location": "ml/intent_analyzer/",
      "files": [
        {
          "name": "intent_classifier.py",
          "description": "의도 분류 클래스"
        },
        {
          "name": "few_shot_prompts.py",
          "description": "Few-shot 학습 프롬프트"
        }
      ],
      "features": [
        {
          "name": "5가지 Intent 분류",
          "description": "사용자 의도를 5가지 카테고리로 분류",
          "intents": [
            "가격·가성비",
            "감성·스타일",
            "시즌·날씨",
            "체형·핏",
            "코디·상황"
          ]
        },
        {
          "name": "탐색 의도 감지",
          "description": "사용자가 새로운 것을 찾는지 감지",
          "examples": [
            {
              "input": "새로운 스타일 보여줘",
              "output": {
                "exploration_intent": true
              }
            },
            {
              "input": "다른 거 없어?",
              "output": {
                "exploration_intent": true
              }
            }
          ]
        },
        {
          "name": "카테고리 전환 감지",
          "description": "평소와 다른 카테고리 요청 감지",
          "example": {
            "scenario": "평소 후드티 → 재킷 요청",
            "output": {
              "category_shift": true
            }
          }
        },
        {
          "name": "추천 전략 비율 결정",
          "description": "의도에 따라 추천 비율 자동 결정",
          "strategies": [
            {
              "mode": "탐색 모드",
              "exploitation": 0.3,
              "exploration": 0.7
            },
            {
              "mode": "활용 모드",
              "exploitation": 0.7,
              "exploration": 0.3
            },
            {
              "mode": "카테고리 전환",
              "exploitation": 0.3,
              "bridge": 0.5,
              "exploration": 0.2
            }
          ]
        }
      ],
      "usage_example": {
        "code": "from ml.intent_analyzer import IntentClassifier\n\nclassifier = IntentClassifier(api_key=\"your-key\")\nresult = await classifier.classify_intent(\n    user_message=\"새로운 스타일 보여줘\",\n    chat_history=[],\n    user_profile={}\n)",
        "output": {
          "intent": "감성·스타일",
          "exploration_intent": true,
          "recommendation_strategy": {
            "exploitation": 0.3,
            "exploration": 0.7
          }
        }
      }
    },
    {
      "id": 2,
      "name": "Vector Search",
      "name_kr": "벡터 검색",
      "location": "ml/vector_search/",
      "files": [
        {
          "name": "embedding_service.py",
          "description": "임베딩 생성 서비스"
        },
        {
          "name": "search_engine.py",
          "description": "검색 엔진"
        },
        {
          "name": "sql_vector_store.py",
          "description": "SQL 기반 벡터 스토어"
        },
        {
          "name": "vector_store.py",
          "description": "벡터 스토어 추상 클래스 (Pinecone/Weaviate 지원)"
        }
      ],
      "features": [
        {
          "name": "임베딩 생성",
          "description": "텍스트를 벡터로 변환",
          "specs": {
            "dimensions": 3072,
            "model": "text-embedding-3-large",
            "caching": true
          },
          "conversions": [
            "상품 정보 → 벡터 변환",
            "사용자 쿼리 → 벡터 변환"
          ]
        },
        {
          "name": "유사도 검색",
          "description": "코사인 유사도 기반 검색",
          "method": "SQL 기반 벡터 검색 (Pinecone 대체)",
          "filters": [
            "카테고리",
            "브랜드",
            "가격"
          ]
        },
        {
          "name": "유사도 범위별 검색",
          "description": "유사도 범위에 따라 상품 분류",
          "ranges": [
            {
              "name": "High Similarity",
              "threshold": ">0.8",
              "type": "기존 취향"
            },
            {
              "name": "Mid Similarity",
              "threshold": "0.5~0.8",
              "type": "브릿지 스타일"
            },
            {
              "name": "Low Similarity",
              "threshold": "0.3~0.5",
              "type": "새로운 발견"
            }
          ]
        }
      ],
      "usage_example": {
        "code": "from ml.vector_search import SearchEngine\n\nsearch_engine = SearchEngine(db=db_session)\ncandidates = await search_engine.search_products(\n    query=\"미니멀 셔츠\",\n    user_profile={\"preferred_styles\": [\"미니멀\"]},\n    limit=50\n)",
        "output": {
          "type": "List[ProductCandidate]",
          "fields": [
            "similarity_score: 유사도 점수",
            "recommendation_type: EXPLOITATION/EXPLORATION/BRIDGE"
          ]
        }
      }
    },
    {
      "id": 3,
      "name": "MMR Algorithm",
      "name_kr": "다양성 추천",
      "location": "ml/mmr_algorithm/",
      "files": [
        {
          "name": "mmr_scorer.py",
          "description": "MMR 알고리즘 구현"
        },
        {
          "name": "diversity_calculator.py",
          "description": "다양성 점수 계산"
        }
      ],
      "features": [
        {
          "name": "MMR 점수 계산",
          "description": "유사도와 다양성의 균형",
          "formula": "MMR = λ × Similarity(q, d) - (1-λ) × max Similarity(d, d')",
          "parameters": {
            "lambda": 0.7,
            "description": "유사도 vs 다양성 가중치"
          }
        },
        {
          "name": "다양성 보장",
          "description": "다양한 차원에서 다양성 확보",
          "dimensions": [
            {
              "name": "스타일 다양성",
              "requirement": "3개 이상 다른 스타일 필수"
            },
            {
              "name": "카테고리 다양성",
              "requirement": "다양한 카테고리 포함"
            },
            {
              "name": "컬러 다양성",
              "requirement": "다양한 색상 포함"
            },
            {
              "name": "가격 다양성",
              "requirement": "다양한 가격대 포함"
            },
            {
              "name": "브랜드 다양성",
              "requirement": "동일 브랜드 최대 2개"
            }
          ]
        },
        {
          "name": "추천 전략 반영",
          "description": "의도 분석 결과에 따른 비율 조정",
          "features": [
            "exploitation/exploration/bridge 비율에 따라 선택",
            "유형별 목표 개수 자동 계산"
          ]
        }
      ],
      "usage_example": {
        "code": "from ml.mmr_algorithm import MMRScorer\n\nmmr_scorer = MMRScorer(lambda_param=0.7)\nresult = await mmr_scorer.select_recommendations(\n    query_embedding=query_vector,\n    candidates=product_candidates,\n    target_count=10,\n    strategy={\"exploitation\": 0.7, \"exploration\": 0.3}\n)",
        "output": {
          "type": "MMRResult",
          "fields": [
            "selected_products: 선택된 상품 리스트",
            "total_diversity_score: 전체 다양성 점수",
            "type_distribution: 유형별 분포"
          ]
        }
      }
    },
    {
      "id": 4,
      "name": "Response Generator",
      "name_kr": "응답 생성",
      "location": "ml/response_generator/",
      "files": [
        {
          "name": "response_generator.py",
          "description": "응답 생성 클래스"
        },
        {
          "name": "prompt_templates.py",
          "description": "프롬프트 템플릿 관리"
        }
      ],
      "features": [
        {
          "name": "의도별 템플릿 선택",
          "description": "Intent에 따라 적절한 템플릿 사용",
          "templates": [
            {
              "intent": "가격·가성비",
              "template": "price_value"
            },
            {
              "intent": "감성·스타일",
              "template": "style_mood"
            },
            {
              "intent": "시즌·날씨",
              "template": "season_weather"
            },
            {
              "intent": "체형·핏",
              "template": "fit_body"
            },
            {
              "intent": "코디·상황",
              "template": "coordination_situation"
            }
          ]
        },
        {
          "name": "응답 구조 (4단계)",
          "description": "구조화된 응답 생성",
          "steps": [
            "공감 + 의도 확인",
            "새로운 발견 추천 (70%)",
            "기존 취향 추천 (30%)",
            "꼬리질문 or 대안 제시 (최대 2개)"
          ]
        },
        {
          "name": "후처리 규칙",
          "description": "응답 품질 보장",
          "rules": [
            "질문 개수 제한 (최대 2개)",
            "이모지 사용 제어",
            "길이 제한 (1000자)",
            "안전성 필터"
          ]
        }
      ],
      "usage_example": {
        "code": "from ml.response_generator import ResponseGenerator\n\ngenerator = ResponseGenerator(api_key=\"your-key\")\nresponse = await generator.generate_response(\n    user_message=\"미니멀 셔츠 추천해줘\",\n    intent_result=intent_result,\n    recommendations=recommendations,\n    user_profile=user_profile,\n    chat_history=chat_history\n)",
        "output": {
          "type": "자연어 응답 문자열"
        }
      }
    }
  ],
