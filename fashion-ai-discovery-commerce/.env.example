# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo

# Embedding Configuration
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536

# Vector Database Configuration
VECTOR_DB_TYPE=pinecone  # pinecone or weaviate
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=your-pinecone-environment
PINECONE_INDEX_NAME=fashion-products

# Weaviate Configuration (Alternative to Pinecone)
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=your-weaviate-api-key

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_SESSION_TTL=3600

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/fashion_ai_db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# Security
SECRET_KEY=your-super-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# MMR Algorithm Configuration
MMR_LAMBDA=0.7  # 유사도/다양성 가중치 (0~1)
EXPLORATION_RATIO=0.7  # 탐색적 추천 비율
EXPLOITATION_RATIO=0.3  # 기존 취향 비율

# Recommendation Configuration
MAX_RECOMMENDATIONS=10
MIN_SIMILARITY_THRESHOLD=0.3
MAX_SIMILARITY_THRESHOLD=0.9
RECENT_HISTORY_LIMIT=5  # 최근 추천 이력 제외 개수

# Intent Analysis Configuration
INTENT_CONFIDENCE_THRESHOLD=0.8
MAX_FOLLOW_UP_QUESTIONS=2

# Response Generation Configuration
RESPONSE_TEMPLATE_PATH=ml/response_generator/templates
MAX_RESPONSE_LENGTH=1000
USE_EMOJIS=true

# Performance Configuration
CACHE_TTL=3600
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=30

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Feature Flags
ENABLE_IMAGE_SEARCH=false
ENABLE_VOICE_INTERFACE=false
ENABLE_MULTIMODAL=false
ENABLE_AB_TESTING=true